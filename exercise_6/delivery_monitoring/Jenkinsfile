pipeline {
    agent any

    stages {
        stage('Pre-check Docker') {
            steps {
                sh 'docker --version'
                sh 'docker info'
            }
        }

        stage('Validate Configuration') {
            steps {
                sh 'python3 -m py_compile delivery_metrics.py'
                sh 'test -f prometheus.yml'
                sh 'test -f alert_rules.yml'
            }
        }

        stage('Build Delivery Metrics Image') {
            steps {
                sh 'docker build -t delivery-metrics .'
            }
        }

        stage('Verify Image') {
            steps {
                sh 'docker image inspect delivery-metrics'
            }
        }
    }

    post {
        success {
            echo 'Delivery monitoring pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}
